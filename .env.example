# Local demonstration credentials only. Copy this to .env.
DATABASE_PASSWORD=local-only-password
KEYCLOAK_ADMIN_PASSWORD=local-admin-password
OIDC_ISSUER=http://localhost:8180/realms/opsflow
OIDC_AUDIENCE=opsflow-api
OIDC_JWKS=http://keycloak:8080/realms/opsflow/protocol/openid-connect/certs
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/opsflow
VITE_OIDC_CLIENT_ID=opsflow-web
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_AUTHORIZATION_AUDIENCE=
VITE_API_URL=/api
CACHE_ENABLED=true
