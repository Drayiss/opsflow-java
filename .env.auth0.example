# Local Docker services with Auth0 sign-in. Copy to .env.auth0.local and edit.
# These database/Keycloak passwords are local demonstration values only.
DATABASE_PASSWORD=local-only-password
KEYCLOAK_ADMIN_PASSWORD=local-admin-password
OIDC_ISSUER=https://YOUR-TENANT.us.auth0.com/
OIDC_JWKS=https://YOUR-TENANT.us.auth0.com/.well-known/jwks.json
OIDC_AUDIENCE=https://opsflow-api
VITE_OIDC_AUTHORITY=https://YOUR-TENANT.us.auth0.com/
VITE_OIDC_CLIENT_ID=YOUR-SPA-CLIENT-ID
VITE_OIDC_SCOPE=openid profile email offline_access access_as_user
VITE_OIDC_AUTHORIZATION_AUDIENCE=https://opsflow-api
VITE_API_URL=/api
CACHE_ENABLED=true
